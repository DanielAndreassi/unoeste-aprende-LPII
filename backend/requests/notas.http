# Roteiro de demonstração: avaliações, notas e média. Senha do seed: Senha123.
# Rode antes: docker compose exec backend npm run seed.
# Troque @turma, @avaliacao e @aluno pelos _id (GET /turmas/{{turma}}/notas devolve avaliações e alunos).
@api = http://localhost:3000/api
@turma = COLE_O_ID_DA_TURMA
@avaliacao = COLE_O_ID_DE_UMA_AVALIACAO
@aluno = COLE_O_ID_DE_UM_ALUNO

### Login do professor
# @name loginProf
POST {{api}}/auth/login
Content-Type: application/json

{ "email": "prof1@aprender.local", "senha": "Senha123" }

###
@tokenProf = {{loginProf.response.body.token}}

### Login do aluno
# @name loginAluno
POST {{api}}/auth/login
Content-Type: application/json

{ "email": "aluno1@aprender.local", "senha": "Senha123" }

###
@tokenAluno = {{loginAluno.response.body.token}}

### Professor: tabela da turma (notas, média e situação)
GET {{api}}/turmas/{{turma}}/notas
Authorization: Bearer {{tokenProf}}

### Aluno: só as próprias notas
GET {{api}}/turmas/{{turma}}/notas
Authorization: Bearer {{tokenAluno}}

### Professor: cria avaliação
POST {{api}}/turmas/{{turma}}/avaliacoes
Authorization: Bearer {{tokenProf}}
Content-Type: application/json

{ "nome": "Prova 2", "peso": 2, "data": "2026-11-20T00:00:00.000Z" }

### Professor: lança notas em lote (valor null apaga)
PUT {{api}}/avaliacoes/{{avaliacao}}/notas
Authorization: Bearer {{tokenProf}}
Content-Type: application/json

[{ "aluno": "{{aluno}}", "valor": 9 }]

### Erro esperado (400): nota fora de 0–10
PUT {{api}}/avaliacoes/{{avaliacao}}/notas
Authorization: Bearer {{tokenProf}}
Content-Type: application/json

[{ "aluno": "{{aluno}}", "valor": 11 }]

### Erro esperado (403): aluno não lança nota
PUT {{api}}/avaliacoes/{{avaliacao}}/notas
Authorization: Bearer {{tokenAluno}}
Content-Type: application/json

[{ "aluno": "{{aluno}}", "valor": 10 }]

### Professor: edita avaliação
PUT {{api}}/avaliacoes/{{avaliacao}}
Authorization: Bearer {{tokenProf}}
Content-Type: application/json

{ "peso": 3 }

### Professor: exclui avaliação (apaga as notas dela)
DELETE {{api}}/avaliacoes/{{avaliacao}}
Authorization: Bearer {{tokenProf}}
